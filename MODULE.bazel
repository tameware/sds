module(
    name = "sds",
    version = "0.1.0",
)

# apple_support before rules_cc so the Xcode toolchain wins over the generic
# Unix toolchain (required on newer macOS/Xcode SDKs).
bazel_dep(name = "apple_support", version = "2.10.1")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
