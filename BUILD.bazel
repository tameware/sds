load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//:CPPVARIABLES.bzl", "SDS_BASE_CPPOPTS", "SDS_LINKOPTS")

config_setting(
    name = "build_macos",
    constraint_values = ["@platforms//os:osx"],
)

config_setting(
    name = "debug_build_macos",
    constraint_values = ["@platforms//os:osx"],
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "build_linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "debug_build_linux",
    constraint_values = ["@platforms//os:linux"],
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "build_windows",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "debug_build_windows",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    values = {"compilation_mode": "dbg"},
)

SDS_CPPOPTS = ["-std=c++20"] + SDS_BASE_CPPOPTS + select({
    "//:build_windows": [],
    "//:debug_build_windows": [],
    "//conditions:default": ["-Wno-deprecated-declarations"],
})

SDS_LOCAL_DEFINES = select({
    "//:build_windows": ["_CRT_SECURE_NO_WARNINGS"],
    "//:debug_build_windows": ["_CRT_SECURE_NO_WARNINGS"],
    "//conditions:default": [],
})

cc_library(
    name = "single_dummy_solver_lib",
    srcs = [
        "src/single_dummy_solver/single_dummy_solver_lib.cpp",
        "src/single_dummy_solver/transposition_table.cpp",
    ],
    hdrs = [
        "src/single_dummy_solver/bridge_types.hpp",
        "src/single_dummy_solver/single_dummy_solver.hpp",
        "src/single_dummy_solver/transposition_table.hpp",
    ],
    includes = ["src/single_dummy_solver"],
    copts = SDS_CPPOPTS,
    local_defines = SDS_LOCAL_DEFINES,
)

cc_binary(
    name = "single_dummy_solver",
    srcs = ["src/single_dummy_solver/single_dummy_solver.cpp"],
    copts = SDS_CPPOPTS,
    linkopts = SDS_LINKOPTS,
    local_defines = SDS_LOCAL_DEFINES,
    deps = [":single_dummy_solver_lib"],
)

cc_test(
    name = "single_dummy_solver_test",
    size = "small",
    srcs = ["tests/single_dummy_solver_test.cpp"],
    copts = SDS_CPPOPTS,
    local_defines = SDS_LOCAL_DEFINES,
    deps = [
        ":single_dummy_solver_lib",
        "@googletest//:gtest_main",
    ],
)
